# MongoDB
# Local: Docker (pnpm docker:up)
# Produção (Vercel): MongoDB Atlas Free (M0) — connection string com user/password
MONGODB_URI=mongodb://localhost:27017/sost-dashboard

# API
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Admin bootstrap (used by pnpm seed:admin / primeiro boot da API)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Web (Vite) — local
VITE_API_URL=http://localhost:3000
# Produção: URL do projeto Vercel da API, ex.: https://sost-api.vercel.app

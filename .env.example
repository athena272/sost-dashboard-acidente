# MongoDB
# Local: Docker (pnpm docker:up)
# Produção / seed Atlas: connection string com user/password e NOME DO DATABASE na path
#   SRV (preferencial):
#   MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/sost-dashboard?retryWrites=true&w=majority
#   Se Node falhar com querySrv ECONNREFUSED (comum em alguns DNS/Windows), use a string clássica multi-host do Atlas Connect
#   (também com /sost-dashboard antes do ?). Sem o nome do DB o driver usa "test".
MONGODB_URI=mongodb://localhost:27017/sost-dashboard

# API
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Admin bootstrap (used by pnpm seed:admin / primeiro boot da API)
# Senhas com & ! etc.: use aspas no .env e no PowerShell ($env:ADMIN_PASSWORD="...")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Web (Vite) — local
VITE_API_URL=http://localhost:3000
# Produção: URL do projeto Vercel da API, ex.: https://sost-api.vercel.app

# Não versionar: .env, .env.local, .env.atlas (credenciais Atlas)
